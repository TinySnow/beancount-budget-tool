option "operating_currency" "CNY"

2026-09-01 open Assets:Cash
2026-09-01 open Income:Salary
2026-09-01 open Expenses:Food

2026-09-01 * "示例工资"
  Assets:Cash 500 CNY
  Income:Salary -500 CNY

2026-09-02 * "同账户留出日常支出资金"
  Assets:Cash 200 CNY
    fund: "待支出资金"
  Assets:Cash -200 CNY

2026-09-03 * "示例餐饮"
  Expenses:Food 10 CNY
    budget: "日常开销.餐饮"
  Assets:Cash -10 CNY
